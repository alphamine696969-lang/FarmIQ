# FarmIQ Environment Configuration
# Copy this file to .env.local and configure your production credentials.

# Public Application
NEXT_PUBLIC_APP_NAME="FarmIQ"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google Authentication (Google Cloud OAuth 2.0 Credentials)
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_PROJECT_ID="your-google-project-id"

# Supabase (Database, Auth, Storage)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# AI Provider — TokenHarbor OpenAI-compatible gateway (server-side only)
# Leave AI_API_KEY empty for labeled local fallbacks (ADR-005/ADR-008).
AI_BASE_URL="https://tokenharbor.ai/v1"
AI_API_KEY=""
# Model overrides (defaults: generation mimo-v2.6-flash:free, intent deepseek-v4.1-flash:free)
AI_GENERATION_MODEL=""
AI_INTENT_MODEL=""
# Opt-in: only if your gateway serves an embeddings model (needed for pgvector retrieval)
AI_EMBEDDING_MODEL=""
# Opt-in: crop photo analysis model (default mimo-v2.6-flash:free; ADR-012)
AI_VISION_MODEL=""

# Translation — Google Translate v2 (leave empty to disclose a translation limitation)
GOOGLE_TRANSLATE_API_KEY=""

# Weather Provider: NASA POWER Agroclimatology (NASA Langley Research Center)
# Free open access for all global coordinates — NO API KEY REQUIRED.
# Documentation: https://power.larc.nasa.gov/docs/tutorials/api-getting-started/
NASA_POWER_COMMUNITY="AG"

# Market Intelligence Providers
MARKET_DATA_API_KEY=""

# Geocoding & Currency Exchange Providers
MAPS_API_KEY=""
EXCHANGE_RATE_API_KEY=""
